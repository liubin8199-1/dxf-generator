# 生成产物（examples/ 下所有 out* 目录，含 1.6G 的 out_dwg/）
# 用通配符一次性覆盖，含未来新增：out / out_adv / out_atlas / out_deliver_v117 /
# out_nodes(_routing) / out_pingfa / out_pipeline / out_probe / out_steel_nodes /
# out_v11x / out_verify(_v117) 等全部 out* 目录
examples/out*/
# 误建的嵌套目录（历史遗留）
examples/examples/

# 开发/调试辅助脚本（probe_* 探测脚本、_* 临时脚本，不入库）
examples/probe_*.py
examples/_*.py

# 二进制/导出文件
*.png
*.pdf
*.svg
*.jpg
*.jpeg
*.webp
*.obj
*.stl
*.ply
*.xlsx
*.npy

# 回收暂存（可逆清理，确认无用后再删）
_trash_*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# 识图评测原始图纸（可能 100MB+，不入库；用 benchmarks/import_samples.py 本地导入）
benchmarks/raw/*
!benchmarks/raw/.gitkeep

# 真值表自动备份（import_samples.py / check_provenance.py --apply 每次落盘都会生成）
benchmarks/*.bak_*.json
